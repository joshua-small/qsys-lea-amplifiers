<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>JoshuaSmall.Qsys.LeaAmplifiers</PackageId>
    <Version>1.4.2.9</Version>
    <Title>LEA Amplifiers - Custom Model Support</Title>
    <Authors>Joshua Small</Authors>
    <Description>Independent LEA Connect Series custom Q-SYS plugin with CS62 and CS122 model support.</Description>
    <PackageProjectUrl>https://github.com/joshua-small/qsys-lea-amplifiers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joshua-small/qsys-lea-amplifiers</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconUrl>https://joshua-small.github.io/qsys-lea-amplifiers/icon.png</PackageIconUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Q-SYS;Plugin;LeaAmplifiers</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="content/LeaAmplifierCustom.qplug" Pack="true" PackagePath="content/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
