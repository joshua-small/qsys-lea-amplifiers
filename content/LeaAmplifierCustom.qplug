-- LEA Amplifier
-- Mike Matthews, Martin Velez
-- 21 June 2019
-- Custom fork maintained by Joshua Small: CS62/62D and CS122/122D support.

-- Q-SYS health semantics; neutral testing is not a health confirmation.
IndicatorGreen = { 0, 255, 0 }
IndicatorRed = { 255, 0, 0 }
IndicatorOrange = { 230, 171, 56 }
IndicatorNeutral = { 128, 128, 128 }
-- These feedback controls deliberately distinguish observed OK/fault/no-signal.
IndicatorGreenHex = "#00FF00"
IndicatorRedHex = "#FF0000"
IndicatorUnknownHex = "#C8C8C8"

PluginInfo = {
  Name = "LEA Amplifier~Custom Model Support",
  Version = "1.4.2.9",
  Id = "13ea79f5-94d9-48d1-9edc-7b9342044e77",
  Description = "Custom LEA Connect Series integration with CS62 and CS122 models; independently maintained",
  ShowDebug = true,
}

function GetColor(props)
  return { 0, 0, 0 }
end

function GetPrettyName(props)
  return "LEA Amplifier Custom v" .. PluginInfo.Version
end

local amplifierModels = {
  "352",  "352D", "354", "354D",
  "702",  "702D", "704", "704D",
  "34",   "34D",
  "62",   "62D",  "64",  "64D",
  "84",   "84D",  "88",  "88D",
  "122",  "122D", "124", "124D",
  "164",  "164D", "168", "168D",
  "1504", "1504D"
}

local modelsWith8Gpio = { "84", "84D", "88", "88D", "164", "164D", "168", "168D" }

local modelsWithLineInput = { "34", "34D", "62", "62D", "64", "64D", "122", "122D", "124", "124D" }

local modelsWith8DanteChannels = { "352D", "354D", "702D", "704D", "84D", "88D", "164D", "168D", "1504D" }

function GetProperties()
  local props = {
    {
      Name = "Amplifier Model",
      Type = "enum",
      Choices = amplifierModels,
      Value = "352",
    },
    -- {
    --   Name = "Amplifier Type",
    --   Type = "enum",
    --   Choices = {"No Dante", "Dante Enabled"},
    --   Value = "No Dante"
    -- },
    -- {
    --   Name = "Channel Count",
    --   Type = "enum",
    --   Choices = {"2", "4", "8"},
    --   Value = "8"
    -- }
  }

  return props
end

local function hasLineInputs(props)
  local selected = props["Amplifier Model"].Value
  for _, model in ipairs(modelsWithLineInput) do
    if model == selected then
      return true
    end
  end
  return false
end

